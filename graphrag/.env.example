# ─── Copy this to .env and fill in your values ────────────────────────────────

# Neo4j (same instance as kg/)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Gemini API key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_INTENT_MODEL=gemini-2.5-flash

# Groq (optional fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ChromaDB path — must point to the same DB created by kg_ingest.py
# If you kept the default kg/ layout, this relative path works as-is.
CHROMA_PATH=../kg/db/chroma_kg
CHROMA_COLLECTION_NAME=rera_kg_units
CHROMA_EMBED_MODEL=all-MiniLM-L6-v2

# Retrieval tuning
VECTOR_TOP_K=30        # number of ChromaDB results to fetch
GRAPH_MAX_RESULTS=50   # max Neo4j results per query
FINAL_TOP_N=30         # max projects shown in final answer
