# ─── Copy this file to .env and fill in your values ──────────────────────────

# Neo4j connection (Docker: docker run -p 7687:7687 -p 7474:7474 -e NEO4J_AUTH=neo4j/your_password neo4j:5)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# LLM keys
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key   # optional, fallback query planner

# Paths — relative to the kg/ directory
JSON_OUTPUT_DIR=../output          # points to root output/ folder with all brochure JSONs
CHROMA_PATH=./db/chroma_kg         # where ChromaDB stores vectors
CHROMA_COLLECTION_NAME=rera_kg_units
CHROMA_EMBED_MODEL=all-MiniLM-L6-v2

# Ingestion performance
INGEST_WORKERS=8                   # parallel thread count (tune to CPU cores)
INGEST_BATCH_SIZE=200              # ChromaDB upsert batch size

# Models
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
